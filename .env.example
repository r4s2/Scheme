# Copy to .env.local and fill in. Never commit real keys.

# Supabase project (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used for results, ranks, karma and money after the engine checks a change.
SUPABASE_SERVICE_ROLE_KEY=

# Sign-in providers (configure the same values in Supabase Auth where noted)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Riot Sign On needs a Riot production key. Apply at developer.riotgames.com.
RIOT_CLIENT_ID=
RIOT_CLIENT_SECRET=
RIOT_API_KEY=
BATTLENET_CLIENT_ID=
BATTLENET_CLIENT_SECRET=

# Overwatch rank reader (self-hosted OverFast API recommended)
OVERFAST_API_URL=

# Discord bot (runs as a separate always-on worker)
DISCORD_BOT_TOKEN=

# Payments: provider not chosen yet. See docs/DECISIONS.md.
PAYMENTS_PROVIDER=
